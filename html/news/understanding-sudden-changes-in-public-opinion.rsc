10:["$","section","Mengubah Temuan Menjadi Respons",{"children":[["$","h2",null,{"children":"Mengubah Temuan Menjadi Respons"}],[["$","p","Tentukan respons berdasarkan kebutuhan yang terlihat dalam percakapan. Pertanyaan berulang mungkin memerlukan penjelasan yang lebih mudah ditemukan, sedangkan keluhan layanan perlu diteruskan kepada tim yang dapat menyelesaikannya.",{"children":"Tentukan respons berdasarkan kebutuhan yang terlihat dalam percakapan. Pertanyaan berulang mungkin memerlukan penjelasan yang lebih mudah ditemukan, sedangkan keluhan layanan perlu diteruskan kepada tim yang dapat menyelesaikannya."}],["$","p","Setelah mengambil tindakan, pantau apakah topik dan nada percakapan berubah. Catat apa yang dilakukan dan apa yang masih belum terjawab sebagai bahan evaluasi berikutnya.",{"children":"Setelah mengambil tindakan, pantau apakah topik dan nada percakapan berubah. Catat apa yang dilakukan dan apa yang masih belum terjawab sebagai bahan evaluasi berikutnya."}]]]}]
11:["$","section",null,{"className":"blog-recent","aria-labelledby":"recent-title","children":[["$","div",null,{"className":"blog-recent-heading","children":[["$","div",null,{"children":[["$","div",null,{"className":"eyebrow","children":[["$","span",null,{}],"News"]}],["$","h2",null,{"id":"recent-title","children":"Recent blog posts"}]]}],["$","a",null,{"className":"button light","href":"/#news","children":["View All Post ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M5 12h14","key":"1ays0h"}],["path",{"d":"m12 5 7 7-7 7","key":"xquz4c"}]],"className":"lucide-arrow-right","size":22,"aria-hidden":"true"}]]}]]}],["$","div",null,{"className":"blog-recent-grid","children":[["$","a","brand-crisis-detection",{"className":"blog-card-link","href":"/news/brand-crisis-detection","children":[["$","img",null,{"src":"/assets/2a24f2b8-9761-48aa-afe1-443c664ccec1.png","width":320,"height":230,"loading":"lazy","alt":"Brand Crisis Detection: Spot Issues Before They Escalate"}],["$","time",null,{"children":"20 Jan 2025"}],["$","h3",null,{"children":"Brand Crisis Detection: Spot Issues Before They Escalate"}],["$","p",null,{"children":"A sudden increase in negative mentions can be an early warning sign of a potential brand crisis. Social media listening helps teams monitor unusual spikes in conversations, identify the source of the issue, and understand how quickly it is spreading."}]]}],["$","a","competitor-monitoring",{"className":"blog-card-link","href":"/news/competitor-monitoring","children":[["$","img",null,{"src":"/assets/5bf46140-41d7-4748-bca4-5b31724592a0.png","width":320,"height":230,"loading":"lazy","alt":"Competitor Monitoring: Know Where You Stand"}],["$","time",null,{"children":"18 Jan 2025"}],["$","h3",null,{"children":"Competitor Monitoring: Know Where You Stand"}],["$","p",null,{"children":"Understanding what customers say about competitors can reveal valuable insights into the market. By monitoring competitor mentions, brands can identify popular products, recurring complaints, successful campaigns, and changing customer preferences."}]]}]]}]]}]
