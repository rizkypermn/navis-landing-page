1:[[["$","link","css:/_next/static/css/article-detail.BsTzb9it.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/_next/static/css/article-detail.BsTzb9it.css","data-rsc-css-href":"/_next/static/css/article-detail.BsTzb9it.css"}],["$","link","css:/_next/static/css/index.C70-fOlL.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/_next/static/css/index.C70-fOlL.css","data-rsc-css-href":"/_next/static/css/index.C70-fOlL.css"}],"$undefined"],["$","div",null,{"className":"blog-page","children":[["$","$Ld",null,{"light":true}],["$","main",null,{"className":"blog-layout","children":[["$","div",null,{"className":"blog-column","children":[["$","article",null,{"children":[["$","img",null,{"className":"blog-cover","src":"/assets/e6826df5-f7b2-42a2-b940-539b714778dd.png","width":924,"height":606,"alt":"Understanding Sudden Changes in Public Opinion","fetchPriority":"high"}],["$","h1",null,{"children":"Understanding Sudden Changes in Public Opinion"}],["$","div",null,{"className":"blog-meta","children":[["$","div",null,{"children":["$","span",null,{"children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M8 2v3","key":"1ioesn"}],["path",{"d":"M16 2v3","key":"otl347"}],["rect",{"x":"3","y":"3","width":"18","height":"18","rx":"2","key":"h1oib"}],["path",{"d":"M3 9h18","key":"1pudct"}],["path",{"d":"M8 13h.01","key":"1sbv64"}],["path",{"d":"M12 13h.01","key":"y0uutt"}],["path",{"d":"M16 13h.01","key":"wip0gl"}],["path",{"d":"M8 17h.01","key":"p3bg7i"}],["path",{"d":"M12 17h.01","key":"p32p05"}],["path",{"d":"M16 17h.01","key":"ql8jdd"}]],"className":"lucide-calendar-days","size":18,"aria-hidden":"true"}],["$","time",null,{"dateTime":"2025-01-19","children":"19 Jan 2025"}]]}]}],["$","$Lf",null,{}]]}],["$","div",null,{"className":"blog-body","lang":"id","children":[["$","section","Membaca Perubahan Percakapan",{"children":[["$","h2",null,{"children":"Membaca Perubahan Percakapan"}],[["$","p","Opini publik dapat berubah ketika pengalaman baru, berita, atau percakapan yang ramai mengubah cara orang memandang sebuah brand. Lonjakan jumlah mention menjadi titik awal untuk memahami perubahan tersebut, tetapi belum menjelaskan penyebabnya.",{"children":"Opini publik dapat berubah ketika pengalaman baru, berita, atau percakapan yang ramai mengubah cara orang memandang sebuah brand. Lonjakan jumlah mention menjadi titik awal untuk memahami perubahan tersebut, tetapi belum menjelaskan penyebabnya."}],["$","p","Bandingkan percakapan terbaru dengan pola yang biasanya muncul. Perhatikan topik, kanal, dan pengalaman yang paling sering disebut agar tim dapat membedakan perubahan sementara dari masalah yang terus berkembang.",{"children":"Bandingkan percakapan terbaru dengan pola yang biasanya muncul. Perhatikan topik, kanal, dan pengalaman yang paling sering disebut agar tim dapat membedakan perubahan sementara dari masalah yang terus berkembang."}]]]}],["$","section","Memahami Penyebab dan Konteks",{"children":[["$","h2",null,{"children":"Memahami Penyebab dan Konteks"}],[["$","p","Telusuri kapan percakapan mulai meningkat dan peristiwa apa yang mendahuluinya. Peluncuran produk, perubahan layanan, atau unggahan yang banyak dibagikan dapat menghasilkan reaksi yang berbeda di setiap kelompok audiens.",{"children":"Telusuri kapan percakapan mulai meningkat dan peristiwa apa yang mendahuluinya. Peluncuran produk, perubahan layanan, atau unggahan yang banyak dibagikan dapat menghasilkan reaksi yang berbeda di setiap kelompok audiens."}],["$","p","Baca contoh percakapan secara langsung. Label sentimen saja tidak selalu menangkap sarkasme, bahasa lokal, dan maksud di balik komentar. Gabungkan hasil pemantauan dengan pertanyaan yang masuk ke tim layanan pelanggan.",{"children":"Baca contoh percakapan secara langsung. Label sentimen saja tidak selalu menangkap sarkasme, bahasa lokal, dan maksud di balik komentar. Gabungkan hasil pemantauan dengan pertanyaan yang masuk ke tim layanan pelanggan."}]]]}],"$L10"]}]]}],"$L11"]}],"$L12"]}],"$L13"]}]]
